
/* =====================================================
   Generated by generate_qss.py -- do not hand-edit colors.
   Edit the palette dict in generate_qss.py and regenerate.
   ===================================================== */

* {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 11pt;
    outline: none;
}

QMainWindow, QWidget {
    background-color: #F5F5F5;
    color: #121D19;
}

/* ---------------- ToolBar ---------------- */

QToolBar {
    font-family: Consolas, "Courier New", monospace;
    font-size: 9pt;
    background-color: #DDDDDE;
    border: none;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #C9C9C9;
    width: 1px;
    margin: 4px 6px;
}

QToolButton {
    background-color: transparent;
    color: #121D19;
    border: none;
    border-radius: 3px;
    padding: 4px 6px;
}

QToolButton:hover {
    background-color: #1B72C4;
    color: #F5F5F5;
}

QToolButton:pressed {
    background-color: #003F73;
    color: #F5F5F5;
}

QToolButton:checked {
    background-color: #0061B0;
    color: #F5F5F5;
    border-radius: 3px;
}

QToolButton:checked:hover {
    background-color: #1B72C4;
}

QToolButton:focus {
    border: 1px solid #0061B0;
}

QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    width: 8px;
    height: 8px;
}

/* ---------------- Buttons ---------------- */

QPushButton {
    background-color: #0061B0;
    color: #FFFFFF;
    border: none;
    border-radius: 3px;
    padding: 6px 12px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #1B72C4;
}

QPushButton:pressed {
    background-color: #003F73;
}

QPushButton:disabled {
    background-color: #C9C9C9;
    color: #5C5E5D;
}

QPushButton:focus {
    border: 1px solid #003F73;
}

QPushButton[class="secondary"] {
    background-color: transparent;
    border: 1px solid #B3B5B4;
    color: #121D19;
}

QPushButton[class="secondary"]:hover {
    border-color: #0061B0;
    color: #0061B0;
    background-color: #DDDDDE;
}

QPushButton[class="secondary"]:pressed {
    background-color: #C9C9C9;
}

/* Semantic buttons: set dynamic property class="success"/"warning"/"error" */

QPushButton[class="success"] {
    background-color: #1E7B4D;
    color: #FFFFFF;
}

QPushButton[class="warning"] {
    background-color: #8F5A08;
    color: #FFFFFF;
}

QPushButton[class="error"] {
    background-color: #8E1E1E;
    color: #FFFFFF;
}

QDialogButtonBox QPushButton {
    min-width: 72px;
}

/* ---------------- Radio / Checkbox ---------------- */

QRadioButton, QCheckBox {
    spacing: 8px;
    color: #121D19;
    background-color: transparent;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #B3B5B4;
    border-radius: 8px;
    background-color: #FFFFFF;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #B3B5B4;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background-color: #0061B0;
    border-color: #003F73;
}

QRadioButton::indicator:hover, QCheckBox::indicator:hover {
    border-color: #1B72C4;
}

QRadioButton:disabled, QCheckBox:disabled {
    color: #5C5E5D;
}

/* ---------------- Views: Tree / List / Table ---------------- */

QTreeWidget, QTreeView, QListWidget, QListView, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #DDDDDE;
    color: #121D19;
    border: 1px solid #C9C9C9;
    border-radius: 3px;
    selection-background-color: #0061B0;
    selection-color: #F5F5F5;
    gridline-color: #C9C9C9;
    outline: none;
}

QTableView {
    gridline-color: #C9C9C9;
}

QTableCornerButton::section {
    background-color: #C9C9C9;
    border: none;
    border-right: 1px solid #B3B5B4;
    border-bottom: 1px solid #B3B5B4;
}

QTreeView::item, QListView::item, QTableView::item {
    padding: 4px;
}

QTreeView::item:hover, QListView::item:hover, QTableView::item:hover {
    background-color: #DDDDDE;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background-color: #0061B0;
    color: #F5F5F5;
}

QTreeView::item:selected:hover, QListView::item:selected:hover, QTableView::item:selected:hover {
    background-color: #1B72C4;
}

QTreeView::branch {
    background-color: transparent;
}

QTreeView::branch:hover {
    background-color: #DDDDDE;
}

QTreeView::branch:has-siblings:!adjoins-item,
QTreeView::branch:!has-siblings:!adjoins-item {
    border-image: none;
}

QHeaderView::section {
    background-color: #C9C9C9;
    color: #121D19;
    padding: 6px;
    border: none;
    border-right: 1px solid #B3B5B4;
    border-bottom: 1px solid #B3B5B4;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #B3B5B4;
}

/* ---------------- Tabs ---------------- */

QTabWidget::pane {
    border: 1px solid #C9C9C9;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background-color: #DDDDDE;
    color: #121D19;
    padding: 6px 12px;
    margin-right: 2px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

QTabBar::tab:selected {
    background-color: #0061B0;
    color: #F5F5F5;
    border-bottom: 2px solid #003F73;
}

QTabBar::tab:hover:selected {
    background-color: #1B72C4;
}

QTabBar::tab:hover {
    background-color: #C9C9C9;
}

QTabBar::close-button {
    image: none;
    background-color: transparent;
    border-radius: 2px;
}

QTabBar::close-button:hover {
    background-color: #003F73;
}

/* ---------------- Inputs ---------------- */

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit,
QDateTimeEdit, QTextEdit, QPlainTextEdit {
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    background-color: #FFFFFF;
    color: #121D19;
    border: 1px solid #C9C9C9;
    border-radius: 3px;
    padding: 4px 8px;
    selection-background-color: #0061B0;
    selection-color: #F5F5F5;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover,
QDateEdit:hover, QTimeEdit:hover, QDateTimeEdit:hover, QTextEdit:hover,
QPlainTextEdit:hover {
    border: 1px solid #B3B5B4;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus, QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #0061B0;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QDateEdit:disabled, QTimeEdit:disabled,
QDateTimeEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #DDDDDE;
    color: #5C5E5D;
    border: 1px solid #C9C9C9;
}

/* Validation states: set dynamic property state="error"/"warning"/"success" */

QLineEdit[state="error"] {
    border: 1px solid #8E1E1E;
}

QLineEdit[state="warning"] {
    border: 1px solid #8F5A08;
}

QLineEdit[state="success"] {
    border: 1px solid #1E7B4D;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #121D19;
    border: 1px solid #C9C9C9;
    border-radius: 3px;
    selection-background-color: #0061B0;
    selection-color: #F5F5F5;
    outline: none;
    padding: 2px;
}

/* Spin box arrows */

QSpinBox::up-button, QDoubleSpinBox::up-button,
QDateEdit::up-button, QTimeEdit::up-button, QDateTimeEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-left: 1px solid #C9C9C9;
    border-top-right-radius: 3px;
    background-color: #DDDDDE;
}

QSpinBox::down-button, QDoubleSpinBox::down-button,
QDateEdit::down-button, QTimeEdit::down-button, QDateTimeEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border-left: 1px solid #C9C9C9;
    border-bottom-right-radius: 3px;
    background-color: #DDDDDE;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QDateEdit::up-button:hover, QDateEdit::down-button:hover,
QTimeEdit::up-button:hover, QTimeEdit::down-button:hover,
QDateTimeEdit::up-button:hover, QDateTimeEdit::down-button:hover {
    background-color: #1B72C4;
}

QSpinBox::up-arrow, QSpinBox::down-arrow,
QDoubleSpinBox::up-arrow, QDoubleSpinBox::down-arrow,
QDateEdit::up-arrow, QDateEdit::down-arrow,
QTimeEdit::up-arrow, QTimeEdit::down-arrow,
QDateTimeEdit::up-arrow, QDateTimeEdit::down-arrow {
    width: 8px;
    height: 8px;
}

/* ---------------- Calendar ---------------- */

QCalendarWidget QWidget {
    background-color: #FFFFFF;
    color: #121D19;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #121D19;
    padding: 4px 8px;
}

QCalendarWidget QToolButton:hover {
    background-color: #1B72C4;
    color: #F5F5F5;
}

QCalendarWidget QMenu {
    background-color: #FFFFFF;
    color: #121D19;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #FFFFFF;
    color: #121D19;
    selection-background-color: #0061B0;
    selection-color: #F5F5F5;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #5C5E5D;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #DDDDDE;
}

/* ---------------- GroupBox ---------------- */

QGroupBox {
    border: 1px solid #C9C9C9;
    border-radius: 6px;
    margin-top: 12px;
    padding: 8px;
    color: #121D19;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    background-color: #F5F5F5;
    color: #0061B0;
}

/* ---------------- Menu / MenuBar ---------------- */

QMenuBar {
    background-color: #DDDDDE;
    color: #121D19;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #0061B0;
    color: #F5F5F5;
    border-radius: 3px;
}

QMenu {
    background-color: #FFFFFF;
    color: #121D19;
    border: 1px solid #C9C9C9;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #0061B0;
    color: #F5F5F5;
}

QMenu::item:disabled {
    color: #5C5E5D;
}

QMenu::separator {
    height: 1px;
    background-color: #C9C9C9;
    margin: 4px 8px;
}

/* ---------------- Dialog / MessageBox ---------------- */

QDialog {
    background-color: #F5F5F5;
    color: #121D19;
}

QMessageBox {
    background-color: #F5F5F5;
}

QMessageBox QLabel {
    color: #121D19;
}

/* ---------------- DockWidget ---------------- */

QDockWidget {
    color: #121D19;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #C9C9C9;
    padding: 6px 8px;
    border: 1px solid #B3B5B4;
    border-bottom: none;
}

QDockWidget::close-button, QDockWidget::float-button {
    background-color: transparent;
    border: none;
    border-radius: 2px;
    padding: 2px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #1B72C4;
}

/* ---------------- Slider ---------------- */

QSlider::groove:horizontal {
    height: 4px;
    background: #C9C9C9;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #0061B0;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #0061B0;
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #1B72C4;
}

QSlider::handle:horizontal:pressed {
    background: #003F73;
}

/* ---------------- Splitter ---------------- */

QSplitter::handle {
    background-color: #C9C9C9;
}

QSplitter::handle:hover {
    background-color: #0061B0;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ---------------- ScrollBar ---------------- */

QScrollBar:vertical {
    background: #DDDDDE;
    width: 12px;
    margin: 0;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #0061B0;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #1B72C4;
}

QScrollBar::handle:vertical:pressed {
    background: #003F73;
}

QScrollBar:horizontal {
    background: #DDDDDE;
    height: 12px;
    margin: 0;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background: #0061B0;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #1B72C4;
}

QScrollBar::handle:horizontal:pressed {
    background: #003F73;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

/* ---------------- StatusBar ---------------- */

QStatusBar {
    background-color: #DDDDDE;
    color: #121D19;
}

QStatusBar::item {
    border: none;
}

/* ---------------- ProgressBar ---------------- */

QProgressBar {
    border: 1px solid #C9C9C9;
    border-radius: 3px;
    text-align: center;
    background-color: #DDDDDE;
    color: #121D19;
}

QProgressBar::chunk {
    background-color: #0061B0;
    border-radius: 3px;
}

/* Indeterminate (busy) state: give the chunk a distinct look since QSS
   can't animate stripes on its own -- toggle this property from code
   while the task is running, e.g. progressBar.setProperty("busy", True) */

QProgressBar[busy="true"]::chunk {
    background-color: #1B72C4;
}

/* ---------------- ToolTip ---------------- */

QToolTip {
    background-color: #121D19;
    color: #F5F5F5;
    border: 1px solid #003F73;
    border-radius: 3px;
    padding: 4px 8px;
}

/* ---------------- Label ---------------- */

QLabel {
    color: #121D19;
}

QLabel:disabled {
    color: #5C5E5D;
}

QLabel[class="success"] { color: #1E7B4D; }
QLabel[class="warning"] { color: #8F5A08; }
QLabel[class="error"]   { color: #8E1E1E; }
