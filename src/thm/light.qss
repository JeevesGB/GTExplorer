* {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
    outline: none;
}

QMainWindow, QWidget {
    background-color: #F0F0F0;
    color: #121D19;
}

/* ---------------- ToolBar ---------------- */

QToolBar {
    font-family: Consolas, "Courier New", monospace;
    font-size: 9pt;
    background-color: #E4E4E5;
    border: none;
    spacing: 1px;
    padding: 1px;
}

QToolBar::separator {
    background-color: #C9C9C9;
    width: 1px;
    margin: 1px 2px;
}

QToolButton {
    background-color: transparent;
    color: #121D19;
    border: none;
    border-radius: 3px;
    padding: 2px 4px;
}

QToolButton:hover {
    background-color: #1B72C4;
    color: #FFFFFF;
}

QToolButton:pressed {
    background-color: #003F73;
    color: #FFFFFF;
}

QToolButton:checked {
    background-color: #0061B0;
    color: #FFFFFF;
    border-radius: 3px;
}

QToolButton:checked:hover {
    background-color: #1B72C4;
}

QToolButton:focus {
    border: 1px solid #0061B0;
}

QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    width: 8px;
    height: 8px;
}

QToolButton:disabled {
    color: #8A8C8B;
    background-color: transparent;
}

/* ---------------- Buttons ---------------- */

QPushButton {
    background-color: #0061B0;
    color: #FFFFFF;
    border: none;
    border-radius: 3px;
    padding: 3px 10px;
    min-height: 14px;
}

QPushButton:hover {
    background-color: #1B72C4;
}

QPushButton:pressed {
    background-color: #003F73;
}

QPushButton:disabled {
    background-color: #C9C9C9;
    color: #5C5E5D;
}

QPushButton:focus {
    border: 1px solid #003F73;
}

QPushButton[class="secondary"] {
    background-color: transparent;
    border: 1px solid #B3B5B4;
    color: #121D19;
}

QPushButton[class="secondary"]:hover {
    border-color: #0061B0;
    color: #0061B0;
    background-color: #E4E4E5;
}

QPushButton[class="secondary"]:pressed {
    background-color: #D0D0D1;
}

QPushButton[class="secondary"]:disabled {
    background-color: transparent;
    border-color: #C9C9C9;
    color: #8A8C8B;
}

/* Semantic buttons: set dynamic property class="success"/"warning"/"error" */

QPushButton[class="success"] {
    background-color: #1E7B4D;
    color: #FFFFFF;
}

QPushButton[class="warning"] {
    background-color: #8F5A08;
    color: #FFFFFF;
}

QPushButton[class="error"] {
    background-color: #8E1E1E;
    color: #FFFFFF;
}

QDialogButtonBox QPushButton {
    min-width: 60px;
}

/* ---------------- Radio / Checkbox ---------------- */

QRadioButton, QCheckBox {
    spacing: 6px;
    color: #121D19;
    background-color: transparent;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #B3B5B4;
    border-radius: 7px;
    background-color: #FFFFFF;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #B3B5B4;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background-color: #0061B0;
    border-color: #003F73;
}

QRadioButton::indicator:hover, QCheckBox::indicator:hover {
    border-color: #1B72C4;
}

QRadioButton:disabled, QCheckBox:disabled {
    color: #5C5E5D;
}

QRadioButton::indicator:disabled, QCheckBox::indicator:disabled {
    background-color: #F0F0F0;
    border-color: #C9C9C9;
}

QRadioButton::indicator:checked:disabled, QCheckBox::indicator:checked:disabled {
    background-color: #B3B5B4;
    border-color: #C9C9C9;
}

QCheckBox::indicator:indeterminate {
    background-color: #8F5A08;
    border-color: #8F5A08;
}

QRadioButton::indicator:focus, QCheckBox::indicator:focus {
    border: 1px solid #0061B0;
}

/* ---------------- Views: Tree / List / Table ---------------- */

QTreeWidget, QTreeView, QListWidget, QListView, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #E4E4E5;
    color: #121D19;
    border: 1px solid #C9C9C9;
    border-radius: 3px;
    selection-background-color: #0061B0;
    selection-color: #FFFFFF;
    gridline-color: #C9C9C9;
    outline: none;
}

QTableView {
    gridline-color: #C9C9C9;
}

QTableCornerButton::section {
    background-color: #D0D0D1;
    border: none;
    border-right: 1px solid #B3B5B4;
    border-bottom: 1px solid #B3B5B4;
}

QTreeView::item, QListView::item, QTableView::item {
    padding: 2px;
}

QTreeView::item:hover, QListView::item:hover, QTableView::item:hover {
    background-color: #D0D0D1;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background-color: #0061B0;
    color: #FFFFFF;
}

QTreeView::item:selected:hover, QListView::item:selected:hover, QTableView::item:selected:hover {
    background-color: #003F73;
}

/* Window inactive: dim selection so it doesn't compete visually with the
   focused panel (relevant here since the archive tree, struct tree, and
   TIM list all sit side by side and can each hold a stale selection) */
QTreeView::item:selected:active, QListView::item:selected:active, QTableView::item:selected:active {
    background-color: #B3B5B4;
    color: #121D19;
}

QTreeView::branch {
    background-color: transparent;
}

QTreeView::branch:hover {
    background-color: #E4E4E5;
}

QTreeView::branch:has-siblings:adjoins-item,
QTreeView::branch:has-siblings:adjoins-item {
    border-image: none;
}

QHeaderView::section {
    background-color: #D0D0D1;
    color: #121D19;
    padding: 4px;
    border: none;
    border-right: 1px solid #B3B5B4;
    border-bottom: 1px solid #B3B5B4;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #B3B5B4;
}

/* Explicit triangles: with sorting enabled on the archive tree, the
   native sort-indicator glyph isn't guaranteed to stay visible against
   a dark header, so draw it ourselves. */
QHeaderView::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #121D19;
    margin-right: 8px;
}

QHeaderView::up-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #121D19;
    margin-right: 8px;
}

/* Expand/collapse arrows for hierarchical trees (e.g. the "Extracted
   Structure" folder tree) -- same reasoning as the header arrows above. */
QTreeView::branch:has-children:closed {
    image: none;
    border-image: none;
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 5px solid #5C5E5D;
    margin: 0 6px;
}

QTreeView::branch:has-children:open {
    image: none;
    border-image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #5C5E5D;
    margin: 0 6px;
}

QTreeView::branch:has-children:closed:hover,
QTreeView::branch:has-children:open:hover {
    border-left-color: #121D19;
    border-top-color: #121D19;
}

/* ---------------- Tabs ---------------- */

QTabWidget::pane {
    border: 1px solid #C9C9C9;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background-color: #E4E4E5;
    color: #121D19;
    padding: 4px 10px;
    margin-right: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

QTabBar::tab:selected {
    background-color: #0061B0;
    color: #FFFFFF;
    border-bottom: 2px solid #003F73;
}

QTabBar::tab:hover:selected {
    background-color: #1B72C4;
}

QTabBar::tab:hover {
    background-color: #D0D0D1;
}

QTabBar::close-button {
    image: none;
    background-color: transparent;
    border-radius: 2px;
}

QTabBar::close-button:hover {
    background-color: #003F73;
}

/* ---------------- Inputs ---------------- */

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit,
QDateTimeEdit, QTextEdit, QPlainTextEdit {
    font-family: Consolas, "Courier New", monospace;
    font-size: 11px;
    background-color: #FFFFFF;
    color: #121D19;
    border: 1px solid #C9C9C9;
    border-radius: 3px;
    padding: 3px 6px;
    selection-background-color: #0061B0;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover,
QDateEdit:hover, QTimeEdit:hover, QDateTimeEdit:hover, QTextEdit:hover,
QPlainTextEdit:hover {
    border: 1px solid #B3B5B4;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus, QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #0061B0;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QDateEdit:disabled, QTimeEdit:disabled,
QDateTimeEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #E4E4E5;
    color: #5C5E5D;
    border: 1px solid #C9C9C9;
}

/* Read-only text views (e.g. the file preview pane) should look
   inspectable-but-not-editable rather than merely "disabled". */
QTextEdit[readOnly="true"], QPlainTextEdit[readOnly="true"] {
    background-color: #F7F7F7;
    color: #1A2420;
}

QTextEdit[readOnly="true"]:focus, QPlainTextEdit[readOnly="true"]:focus {
    border: 1px solid #B3B5B4;
}

/* Validation states: set dynamic property state="error"/"warning"/"success" */

QLineEdit[state="error"] {
    border: 1px solid #8E1E1E;
}

QLineEdit[state="warning"] {
    border: 1px solid #8F5A08;
}

QLineEdit[state="success"] {
    border: 1px solid #1E7B4D;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #121D19;
}

QComboBox::down-arrow:disabled {
    border-top-color: #8A8C8B;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #121D19;
    border: 1px solid #C9C9C9;
    border-radius: 3px;
    selection-background-color: #0061B0;
    selection-color: #FFFFFF;
    outline: none;
    padding: 2px;
}

/* Spin box arrows */

QSpinBox::up-button, QDoubleSpinBox::up-button,
QDateEdit::up-button, QTimeEdit::up-button, QDateTimeEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 14px;
    border-left: 1px solid #C9C9C9;
    border-top-right-radius: 3px;
    background-color: #E4E4E5;
}

QSpinBox::down-button, QDoubleSpinBox::down-button,
QDateEdit::down-button, QTimeEdit::down-button, QDateTimeEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 14px;
    border-left: 1px solid #C9C9C9;
    border-bottom-right-radius: 3px;
    background-color: #E4E4E5;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QDateEdit::up-button:hover, QDateEdit::down-button:hover,
QTimeEdit::up-button:hover, QTimeEdit::down-button:hover,
QDateTimeEdit::up-button:hover, QDateTimeEdit::down-button:hover {
    background-color: #1B72C4;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QDateEdit::up-arrow, QTimeEdit::up-arrow, QDateTimeEdit::up-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #121D19;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow,
QDateEdit::down-arrow, QTimeEdit::down-arrow, QDateTimeEdit::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #121D19;
}

/* ---------------- Calendar ---------------- */

QCalendarWidget QWidget {
    background-color: #FFFFFF;
    color: #121D19;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #121D19;
    padding: 3px 6px;
}

QCalendarWidget QToolButton:hover {
    background-color: #1B72C4;
    color: #FFFFFF;
}

QCalendarWidget QMenu {
    background-color: #FFFFFF;
    color: #121D19;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #FFFFFF;
    color: #121D19;
    selection-background-color: #0061B0;
    selection-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #5C5E5D;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #E4E4E5;
}

/* ---------------- ScrollArea ---------------- */
/* Used to house the texture/model viewer (see #viewerLabel, #viewerScroll
   below for the specific object-name hooks). */

QScrollArea {
    background-color: #F0F0F0;
    border: 1px solid #C9C9C9;
    border-radius: 3px;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QAbstractScrollArea::corner {
    background-color: #E4E4E5;
    border: none;
}

/* Viewer surface: the texture preview needs a neutral, non-panel
   background so image alpha/checker content reads correctly, and it
   should keep its own border regardless of theme. */
#viewerScroll {
    border: 1px solid #C9C9C9;
    border-radius: 3px;
}

#viewerLabel {
    background-color: #E8E8E8;
}

/* ---------------- GroupBox ---------------- */

QGroupBox {
    border: 1px solid #C9C9C9;
    border-radius: 6px;
    margin-top: 8px;
    padding: 6px;
    color: #121D19;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    background-color: #F0F0F0;
    color: #0061B0;
}

/* ---------------- Menu / MenuBar ---------------- */

QMenuBar {
    background-color: #E4E4E5;
    color: #121D19;
}

QMenuBar::item {
    background-color: transparent;
    padding: 3px 8px;
}

QMenuBar::item:selected {
    background-color: #0061B0;
    color: #FFFFFF;
    border-radius: 3px;
}

QMenu {
    background-color: #FFFFFF;
    color: #121D19;
    border: 1px solid #C9C9C9;
    border-radius: 6px;
    padding: 3px;
}

QMenu::item {
    padding: 4px 20px 4px 10px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #0061B0;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #5C5E5D;
}

QMenu::separator {
    height: 1px;
    background-color: #C9C9C9;
    margin: 3px 6px;
}

QMenu::right-arrow {
    image: none;
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 5px solid #121D19;
    margin-right: 4px;
}

QMenu::right-arrow:selected {
    border-left-color: #FFFFFF;
}

/* ---------------- Dialog / MessageBox ---------------- */

QDialog {
    background-color: #F0F0F0;
    color: #121D19;
}

QMessageBox {
    background-color: #F0F0F0;
}

QMessageBox QLabel {
    color: #121D19;
}

/* ---------------- DockWidget ---------------- */

QDockWidget {
    color: #121D19;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #D0D0D1;
    padding: 4px 6px;
    border: 1px solid #B3B5B4;
    border-bottom: none;
}

QDockWidget::close-button, QDockWidget::float-button {
    background-color: transparent;
    border: none;
    border-radius: 2px;
    padding: 2px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #1B72C4;
}

/* ---------------- Slider ---------------- */

QSlider::groove:horizontal {
    height: 4px;
    background: #C9C9C9;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #0061B0;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #0061B0;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #1B72C4;
}

QSlider::handle:horizontal:pressed {
    background: #003F73;
}

/* ---------------- Splitter ---------------- */

QSplitter::handle {
    background-color: #C9C9C9;
}

QSplitter::handle:hover {
    background-color: #0061B0;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ---------------- ScrollBar ---------------- */

QScrollBar:vertical {
    background: #E4E4E5;
    width: 10px;
    margin: 0;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #0061B0;
    border-radius: 4px;
    min-height: 26px;
}

QScrollBar::handle:vertical:hover {
    background: #1B72C4;
}

QScrollBar::handle:vertical:pressed {
    background: #003F73;
}

QScrollBar:horizontal {
    background: #E4E4E5;
    height: 10px;
    margin: 0;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background: #0061B0;
    border-radius: 4px;
    min-height: 26px;
}

QScrollBar::handle:horizontal:hover {
    background: #1B72C4;
}

QScrollBar::handle:horizontal:pressed {
    background: #003F73;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

/* ---------------- StatusBar ---------------- */

QStatusBar {
    background-color: #E4E4E5;
    color: #121D19;
}

QStatusBar::item {
    border: none;
}

/* ---------------- ProgressBar ---------------- */

QProgressBar {
    border: 1px solid #C9C9C9;
    border-radius: 3px;
    text-align: center;
    background-color: #E4E4E5;
    color: #121D19;
}

QProgressBar::chunk {
    background-color: #0061B0;
    border-radius: 3px;
}

/* Indeterminate (busy) state: give the chunk a distinct look since QSS
   can't animate stripes on its own -- toggle this property from code
   while the task is running, e.g. progressBar.setProperty("busy", True) */

QProgressBar[busy="true"]::chunk {
    background-color: #1B72C4;
}

/* ---------------- ToolTip ---------------- */

QToolTip {
    background-color: #121D19;
    color: #F0F0F0;
    border: 1px solid #003F73;
    border-radius: 3px;
    padding: 3px 6px;
}

/* ---------------- Label ---------------- */

QLabel {
    color: #121D19;
}

QLabel:disabled {
    color: #5C5E5D;
}

QLabel[class="success"] { color: #1E7B4D; }
QLabel[class="warning"] { color: #8F5A08; }
QLabel[class="error"]   { color: #8E1E1E; }
