/* =====================================================
   Generated by generate_qss.py - do not hand-edit colours.
   Theme: dark
   Edit PALETTES / TEMPLATE in generate_qss.py and regenerate.
   ===================================================== */

* {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
    outline: none;
}

QMainWindow, QWidget {
    background-color: #262525;
    color: #FFFFFA;
}

/* ---------------- ToolBar ---------------- */

QToolBar {
    font-family: Consolas, "Courier New", monospace;
    font-size: 9pt;
    background-color: #333138;
    border: none;
    spacing: 2px;
    padding: 2px 4px;
}

QToolBar::separator {
    background-color: #3C3C3C;
    width: 1px;
    margin: 1px 2px;
}

QToolBar QLabel {
    color: #BFBFBF;
    padding: 0 4px;
    background: transparent;
}

QToolBar QComboBox {
    min-height: 18px;
    min-width: 160px;
}

QToolBar QCheckBox {
    spacing: 4px;
    padding: 0 4px;
}

QToolButton {
    background-color: transparent;
    color: #FFFFFA;
    border: none;
    border-radius: 3px;
    padding: 2px 4px;
}

QToolButton:hover {
    background-color: #DA2E2A;
    color: #FFFFFF;
}

QToolButton:pressed {
    background-color: #9B2927;
    color: #FFFFFF;
}

QToolButton:checked {
    background-color: #D42622;
    color: #FFFFFF;
    border-radius: 3px;
}

QToolButton:checked:hover {
    background-color: #DA2E2A;
}

QToolButton:focus {
    border: 1px solid #D42622;
}

QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    width: 8px;
    height: 8px;
}

QToolButton:disabled {
    color: #6B6B6B;
    background-color: transparent;
}

/* Side rail (objectName="railButton") */
#railButton {
    border-radius: 6px;
    padding: 4px;
    margin: 1px;
}

#railButton:checked {
    background-color: #D42622;
    color: #FFFFFF;
}

/* ---------------- Buttons ---------------- */

QPushButton {
    background-color: #D42622;
    color: #FFFFFF;
    border: none;
    border-radius: 3px;
    padding: 3px 10px;
    min-height: 14px;
}

QPushButton:hover {
    background-color: #DA2E2A;
}

QPushButton:pressed {
    background-color: #9B2927;
}

QPushButton:disabled {
    background-color: #3C3C3C;
    color: #BFBFBF;
}

QPushButton:focus {
    border: 1px solid #9B2927;
}

QPushButton:default {
    font-weight: 600;
}

QPushButton[class="secondary"] {
    background-color: transparent;
    border: 1px solid #55535A;
    color: #FFFFFA;
}

QPushButton[class="secondary"]:hover {
    border-color: #D42622;
    color: #D42622;
    background-color: #333138;
}

QPushButton[class="secondary"]:pressed {
    background-color: #3D3B42;
}

QPushButton[class="secondary"]:disabled {
    background-color: transparent;
    border-color: #3C3C3C;
    color: #6B6B6B;
}

QPushButton[class="success"] {
    background-color: #1E7B4D;
    color: #FFFFFF;
}

QPushButton[class="warning"] {
    background-color: #8F5A08;
    color: #FFFFFF;
}

QPushButton[class="error"] {
    background-color: #8E1E1E;
    color: #FFFFFF;
}

QDialogButtonBox QPushButton {
    min-width: 60px;
    min-height: 24px;
}

QDialog QPushButton {
    min-height: 24px;
}

/* ---------------- Radio / Checkbox ---------------- */

QRadioButton, QCheckBox {
    spacing: 6px;
    color: #FFFFFA;
    background-color: transparent;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #55535A;
    border-radius: 7px;
    background-color: #2B2A2A;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #55535A;
    border-radius: 3px;
    background-color: #2B2A2A;
}

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background-color: #D42622;
    border-color: #9B2927;
}

QRadioButton::indicator:hover, QCheckBox::indicator:hover {
    border-color: #DA2E2A;
}

QRadioButton:disabled, QCheckBox:disabled {
    color: #BFBFBF;
}

QRadioButton::indicator:disabled, QCheckBox::indicator:disabled {
    background-color: #262525;
    border-color: #3C3C3C;
}

QRadioButton::indicator:checked:disabled, QCheckBox::indicator:checked:disabled {
    background-color: #55535A;
    border-color: #3C3C3C;
}

QCheckBox::indicator:indeterminate {
    background-color: #8F5A08;
    border-color: #8F5A08;
}

QRadioButton::indicator:focus, QCheckBox::indicator:focus {
    border: 1px solid #D42622;
}

/* ---------------- Views: Tree / List / Table ---------------- */

QTreeWidget, QTreeView, QListWidget, QListView, QTableView, QTableWidget {
    background-color: #2B2A2A;
    alternate-background-color: #333138;
    color: #FFFFFA;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
    selection-background-color: #8E1E1E;
    selection-color: #FFFFFF;
    gridline-color: #3C3C3C;
    outline: none;
}

QTableView, QTableWidget {
    gridline-color: #3C3C3C;
}

QTableCornerButton::section {
    background-color: #3D3B42;
    border: none;
    border-right: 1px solid #55535A;
    border-bottom: 1px solid #55535A;
}

QTreeView::item, QListView::item, QTableView::item, QTableWidget::item {
    padding: 2px;
}

QTreeView::item:hover, QListView::item:hover, QTableView::item:hover, QTableWidget::item:hover {
    background-color: #3D3B42;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected, QTableWidget::item:selected {
    background-color: #8E1E1E;
    color: #FFFFFF;
}

QTreeView::item:selected:hover, QListView::item:selected:hover,
QTableView::item:selected:hover, QTableWidget::item:selected:hover {
    background-color: #9B2927;
}

/* Dim selection when window/panel is inactive */
QTreeView::item:selected:!active,
QListView::item:selected:!active,
QTableView::item:selected:!active,
QTableWidget::item:selected:!active {
    background-color: #55535A;
    color: #FFFFFA;
}

QTreeView::branch {
    background-color: transparent;
}

QTreeView::branch:hover {
    background-color: #333138;
}

QTreeView::branch:has-siblings:adjoins-item {
    border-image: none;
}

QHeaderView::section {
    background-color: #3D3B42;
    color: #FFFFFA;
    padding: 4px;
    border: none;
    border-right: 1px solid #55535A;
    border-bottom: 1px solid #55535A;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #55535A;
}

QHeaderView::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #FFFFFA;
    margin-right: 8px;
}

QHeaderView::up-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #FFFFFA;
    margin-right: 8px;
}

QTreeView::branch:has-children:closed {
    image: none;
    border-image: none;
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 5px solid #BFBFBF;
    margin: 0 6px;
}

QTreeView::branch:has-children:open {
    image: none;
    border-image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #BFBFBF;
    margin: 0 6px;
}

QTreeView::branch:has-children:closed:hover,
QTreeView::branch:has-children:open:hover {
    border-left-color: #FFFFFA;
    border-top-color: #FFFFFA;
}

/* App-specific named widgets (set objectName in code) */
#treeEmptyLabel {
    color: #6B6B6B;
    background: transparent;
    font-size: 11pt;
}

#filterEdit {
    padding: 4px 8px;
    min-height: 20px;
}

#breadcrumb {
    color: #BFBFBF;
    font-size: 9pt;
}

#previewInfo, #viewerInfo {
    color: #BFBFBF;
}

/* Palette editor */
#texPreview {
    background-color: #1C1C1C;
    border: 1px solid #3C3C3C;
    border-radius: 6px;
}
QPushButton#primaryAction {
    min-height: 40px;
    font-weight: 600;
}
QListWidget#clutList::item {
    padding: 3px 6px;
    border-radius: 3px;
}

#statusLabel {
    color: #FFFFFA;
}

#inputList {
    background-color: #2B2A2A;
}

#filelistCombo {
    min-width: 160px;
}

/* ---------------- Tabs ---------------- */

QTabWidget::pane {
    border: 1px solid #3C3C3C;
    border-radius: 3px;
    background-color: #2B2A2A;
}

QTabBar::tab {
    background-color: #333138;
    color: #FFFFFA;
    padding: 4px 10px;
    margin-right: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

QTabBar::tab:selected {
    background-color: #D42622;
    color: #FFFFFF;
    border-bottom: 2px solid #9B2927;
}

QTabBar::tab:hover:selected {
    background-color: #DA2E2A;
}

QTabBar::tab:hover {
    background-color: #3D3B42;
}

QTabBar::close-button {
    image: none;
    background-color: transparent;
    border-radius: 2px;
}

QTabBar::close-button:hover {
    background-color: #9B2927;
}

/* ---------------- Inputs ---------------- */

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit,
QDateTimeEdit, QTextEdit, QPlainTextEdit, QTextBrowser {
    font-family: Consolas, "Courier New", monospace;
    font-size: 11px;
    background-color: #2B2A2A;
    color: #FFFFFA;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
    padding: 3px 6px;
    selection-background-color: #D42622;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover,
QDateEdit:hover, QTimeEdit:hover, QDateTimeEdit:hover, QTextEdit:hover,
QPlainTextEdit:hover, QTextBrowser:hover {
    border: 1px solid #55535A;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus, QTextEdit:focus,
QPlainTextEdit:focus, QTextBrowser:focus {
    border: 1px solid #D42622;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QDateEdit:disabled, QTimeEdit:disabled,
QDateTimeEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled,
QTextBrowser:disabled {
    background-color: #333138;
    color: #BFBFBF;
    border: 1px solid #3C3C3C;
}

QTextEdit[readOnly="true"], QPlainTextEdit[readOnly="true"], QTextBrowser {
    background-color: #252424;
    color: #E8E8E3;
}

QTextEdit[readOnly="true"]:focus, QPlainTextEdit[readOnly="true"]:focus {
    border: 1px solid #55535A;
}

QLineEdit[state="error"] {
    border: 1px solid #8E1E1E;
}

QLineEdit[state="warning"] {
    border: 1px solid #8F5A08;
}

QLineEdit[state="success"] {
    border: 1px solid #1E7B4D;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #FFFFFA;
}

QComboBox::down-arrow:disabled {
    border-top-color: #6B6B6B;
}

QComboBox QAbstractItemView {
    background-color: #2B2A2A;
    color: #FFFFFA;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
    selection-background-color: #D42622;
    selection-color: #FFFFFF;
    outline: none;
    padding: 2px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QDateEdit::up-button, QTimeEdit::up-button, QDateTimeEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 14px;
    border-left: 1px solid #3C3C3C;
    border-top-right-radius: 3px;
    background-color: #333138;
}

QSpinBox::down-button, QDoubleSpinBox::down-button,
QDateEdit::down-button, QTimeEdit::down-button, QDateTimeEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 14px;
    border-left: 1px solid #3C3C3C;
    border-bottom-right-radius: 3px;
    background-color: #333138;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QDateEdit::up-button:hover, QDateEdit::down-button:hover,
QTimeEdit::up-button:hover, QTimeEdit::down-button:hover,
QDateTimeEdit::up-button:hover, QDateTimeEdit::down-button:hover {
    background-color: #DA2E2A;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QDateEdit::up-arrow, QTimeEdit::up-arrow, QDateTimeEdit::up-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #FFFFFA;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow,
QDateEdit::down-arrow, QTimeEdit::down-arrow, QDateTimeEdit::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFA;
}

/* ---------------- Calendar ---------------- */

QCalendarWidget QWidget {
    background-color: #2B2A2A;
    color: #FFFFFA;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #FFFFFA;
    padding: 3px 6px;
}

QCalendarWidget QToolButton:hover {
    background-color: #DA2E2A;
    color: #FFFFFF;
}

QCalendarWidget QMenu {
    background-color: #2B2A2A;
    color: #FFFFFA;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #2B2A2A;
    color: #FFFFFA;
    selection-background-color: #D42622;
    selection-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #BFBFBF;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #333138;
}

/* ---------------- ScrollArea / Viewer ---------------- */

QScrollArea {
    background-color: #262525;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QAbstractScrollArea::corner {
    background-color: #333138;
    border: none;
}

#viewerScroll {
    border: 1px solid #3C3C3C;
    border-radius: 3px;
}

#viewerLabel {
    background-color: #1C1C1C;
}

/* ---------------- GroupBox ---------------- */

QGroupBox {
    border: 1px solid #3C3C3C;
    border-radius: 6px;
    margin-top: 8px;
    padding: 8px;
    color: #FFFFFA;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    background-color: #262525;
    color: #D42622;
}

/* ---------------- Menu / MenuBar ---------------- */

QMenuBar {
    background-color: #333138;
    color: #FFFFFA;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #D42622;
    color: #FFFFFF;
    border-radius: 3px;
}

QMenu {
    background-color: #2B2A2A;
    color: #FFFFFA;
    border: 1px solid #3C3C3C;
    border-radius: 6px;
    padding: 3px;
}

QMenu::item {
    padding: 4px 20px 4px 10px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #D42622;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #BFBFBF;
}

QMenu::separator {
    height: 1px;
    background-color: #3C3C3C;
    margin: 3px 6px;
}

QMenu::right-arrow {
    image: none;
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 5px solid #FFFFFA;
    margin-right: 4px;
}

QMenu::right-arrow:selected {
    border-left-color: #FFFFFF;
}

/* ---------------- Dialog / MessageBox ---------------- */

QDialog {
    background-color: #262525;
    color: #FFFFFA;
}

QMessageBox {
    background-color: #262525;
}

QMessageBox QLabel {
    color: #FFFFFA;
}

/* Setup / help titles (set objectName or class in code) */
#dialogTitle {
    font-size: 16px;
    font-weight: 600;
    color: #FFFFFA;
}

#dialogSubtitle,
QLabel[class="muted"] {
    color: #BFBFBF;
}

/* Links in labels / help browser */
QLabel a, QTextBrowser a {
    color: #DA2E2A;
    text-decoration: none;
}

QLabel a:hover, QTextBrowser a:hover {
    color: #FF6B67;
}

/* ---------------- DockWidget ---------------- */

QDockWidget {
    color: #FFFFFA;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #3D3B42;
    padding: 4px 6px;
    border: 1px solid #55535A;
    border-bottom: none;
}

QDockWidget::close-button, QDockWidget::float-button {
    background-color: transparent;
    border: none;
    border-radius: 2px;
    padding: 2px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #DA2E2A;
}

/* ---------------- Slider ---------------- */

QSlider::groove:horizontal {
    height: 4px;
    background: #3C3C3C;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #D42622;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #D42622;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #DA2E2A;
}

QSlider::handle:horizontal:pressed {
    background: #9B2927;
}

/* ---------------- Splitter ---------------- */

QSplitter::handle {
    background-color: #3C3C3C;
}

QSplitter::handle:hover {
    background-color: #D42622;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

/* ---------------- ScrollBar ---------------- */

QScrollBar:vertical {
    background: #333138;
    width: 10px;
    margin: 0;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #D42622;
    border-radius: 4px;
    min-height: 26px;
}

QScrollBar::handle:vertical:hover {
    background: #DA2E2A;
}

QScrollBar::handle:vertical:pressed {
    background: #9B2927;
}

QScrollBar:horizontal {
    background: #333138;
    height: 10px;
    margin: 0;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background: #D42622;
    border-radius: 4px;
    min-height: 26px;
}

QScrollBar::handle:horizontal:hover {
    background: #DA2E2A;
}

QScrollBar::handle:horizontal:pressed {
    background: #9B2927;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

/* ---------------- StatusBar ---------------- */

QStatusBar {
    background-color: #333138;
    color: #FFFFFA;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #FFFFFA;
    background: transparent;
}

/* ---------------- ProgressBar ---------------- */

QProgressBar {
    border: 1px solid #3C3C3C;
    border-radius: 3px;
    text-align: center;
    background-color: #333138;
    color: #FFFFFA;
    min-height: 14px;
}

QProgressBar::chunk {
    background-color: #D42622;
    border-radius: 3px;
}

QProgressBar[busy="true"]::chunk {
    background-color: #DA2E2A;
}

/* ---------------- ToolTip ---------------- */

QToolTip {
    background-color: #FFFFFA;
    color: #262525;
    border: 1px solid #9B2927;
    border-radius: 3px;
    padding: 3px 6px;
}

/* ---------------- Label ---------------- */

QLabel {
    color: #FFFFFA;
}

QLabel:disabled {
    color: #BFBFBF;
}

QLabel[class="success"] { color: #1E7B4D; }
QLabel[class="warning"] { color: #8F5A08; }
QLabel[class="error"]   { color: #8E1E1E; }
